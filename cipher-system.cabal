cabal-version:      2.4
name:               cipher-system
version:            1.0.0
synopsis:           Cipher System - Classical Cryptography in Haskell

executable cipher-system
  main-is:          Main.hs
  other-modules:    Types, Caesar, Vigenere, Cracker
  build-depends:    base ^>=4.14, containers
  hs-source-dirs:   .
  default-language: Haskell2010
  ghc-options:      -Wall
